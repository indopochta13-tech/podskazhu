# Секреты (не коммитить). Скопируйте в /etc/voicecapture.env и заполните.

# Разбор речи — Yandex Cloud (YandexGPT для уточнения распознавания).
# Сервисный аккаунт: роль ai.languageModels.user.
VC_YC_API_KEY=
VC_YC_FOLDER_ID=

# Поддержка через телеграм-бот @abba_mkt_bot.
VC_TG_BOT_TOKEN=
VC_TG_CHAT_ID=
# VC_TG_API=https://api.telegram.org

# Публичный адрес приложения (QR «Подключить рядом», Prodamus webhook/return).
# Канонический домен: https://soulvoicee.ru
# VC_ORIGIN=https://soulvoicee.ru

# Оплата подписки SoulVoice через Prodamus (как в Psyche, но все способы оплаты).
VC_PRODAMUS_SECRET_KEY=
VC_PRODAMUS_FORM_URL=https://your-shop.payform.ru/
# VC_PRODAMUS_SYS=
# VC_PRODAMUS_NOTIFICATION_URL=https://soulvoicee.ru/api/billing/prodamus/webhook
# VC_PRODAMUS_RETURN_URL=https://soulvoicee.ru/?billing=return
# VC_PRODAMUS_DEMO=1
